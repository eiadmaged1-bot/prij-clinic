# Prij Clinic staging environment example.
# Placeholders only. Use demo/synthetic data unless legal/privacy review approves otherwise.

APP_ENV=staging
NODE_ENV=production
APP_URL=https://staging.example.invalid
API_PORT=3001
API_URL=https://api-staging.example.invalid
CORS_ORIGIN=https://staging.example.invalid

# Inject a staging database URL from a secret manager, not source control.
DATABASE_URL=SECRET_MANAGER_STAGING_DATABASE_URL

# Generate and store in a secret manager. Do not paste a real secret here.
JWT_SECRET=STAGING_SECRET_MANAGER_VALUE
JWT_EXPIRES_IN=1h

# AI remains disabled unless a separate approved AI safety/privacy sprint enables it.
AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled

# Staging storage/backup paths or mounted volumes. No public file URLs.
UPLOAD_STORAGE_ROOT=/var/lib/prij-clinic/uploads
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
BACKUP_ROOT=/var/lib/prij-clinic/backups

# PHI-safe logging only.
LOG_LEVEL=info
LOG_REQUESTS=false
MONITORING_DSN=SECRET_MANAGER_STAGING_MONITORING_DSN_OR_DISABLED

# V0.1 consent/privacy is a foundation only, not production legal enforcement.
CONSENT_PRIVACY_MODE=demo_foundation
