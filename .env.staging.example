# Prij Clinic staging environment example
# Placeholder values only. Staging must use fake/demo data only.

APP_ENV=staging
NODE_ENV=production
API_PORT=3001
API_URL=https://staging-api.example.invalid
APP_URL=https://staging.example.invalid
NEXT_PUBLIC_API_URL=https://staging-api.example.invalid

DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_DB_HOST:5432/STAGING_DB
POSTGRES_DB=prij_clinic_staging
POSTGRES_USER=prij_clinic_staging
POSTGRES_PASSWORD=replace-with-staging-postgres-password
JWT_SECRET=replace-with-random-staging-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
GUIDELINE_VAULT_ENCRYPTION_KEY=replace-with-staging-32-byte-vault-key
GUIDELINE_VAULT_ENCRYPTION_KEY_ID=staging-vault-key-1

AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled

# Staging may load clearly marked fake/demo data for verification.
SEED_DEMO_DATA=true
SEED_DEMO_OWNER=true
DEMO_OWNER_EMAIL=demo.owner@prij.local
DEMO_OWNER_PASSWORD=replace-with-staging-demo-password
DEMO_ADMIN_PASSWORD=replace-with-staging-admin-demo-password
DEMO_TEST_PASSWORD=replace-with-staging-demo-password
