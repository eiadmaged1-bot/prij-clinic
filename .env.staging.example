# Prij Clinic staging environment example
# Placeholder values only. Do not put real secrets in this file.
# v0.18.0 is a staging package only, not a production release.
# Staging must not contain real patient data.

APP_ENV=staging
NODE_ENV=production
API_PORT=3001
API_URL=https://api.your-staging-domain.example
APP_URL=https://your-staging-domain.example
WEB_ORIGIN=https://your-staging-domain.example
NEXT_PUBLIC_API_URL=https://api.your-staging-domain.example
CORS_ORIGINS=https://your-staging-domain.example
CORS_ALLOWED_ORIGINS=https://your-staging-domain.example

DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_DB_HOST:5432/STAGING_DB?schema=public
POSTGRES_DB=prij_clinic_staging
POSTGRES_USER=prij_clinic_staging
POSTGRES_PASSWORD=<set-in-staging-secret-store>
JWT_SECRET=<set-in-staging-secret-store-minimum-32-characters>
JWT_EXPIRES_IN=1h
GUIDELINE_VAULT_ENCRYPTION_KEY=<set-in-staging-secret-store-32-byte-vault-key>
GUIDELINE_VAULT_ENCRYPTION_KEY_ID=staging-vault-key-1

DEMO_MODE=false
PATIENT_FILE_STORAGE_MODE=metadata_only
BACKUP_DIR=backups/staging

AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled_mock
EXTERNAL_AI_ENABLED=false

# Staging verification may use clearly marked fake/demo accounts only.
# Do not seed, import, or upload real patient data.
SEED_DEMO_DATA=false
PRIJ_ENABLE_DEMO_DATA=false
SEED_DEMO_OWNER=false
DEMO_OWNER_EMAIL=staging.owner@example.invalid
DEMO_OWNER_PASSWORD=<set-temporary-fake-staging-owner-password-in-secret-store>
DEMO_ADMIN_PASSWORD=<set-temporary-fake-staging-admin-password-in-secret-store>
DEMO_TEST_PASSWORD=<set-temporary-fake-staging-test-password-in-secret-store>
