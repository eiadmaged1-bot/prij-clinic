# Prij Clinic CI environment example.
# Placeholder values only. GitHub Actions should inject these from workflow env.

APP_ENV=ci
NODE_ENV=test
APP_URL=http://localhost:3000
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://prij_clinic_ci:prij_clinic_ci_password@localhost:5432/prij_clinic_ci
JWT_SECRET=ci-placeholder-secret
JWT_EXPIRES_IN=1h

AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled
DEMO_TEST_PASSWORD=LocalDev123!

UPLOAD_STORAGE_ROOT=uploads
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
BACKUP_ROOT=backups
LOG_LEVEL=info
LOG_REQUESTS=false
MONITORING_DSN=disabled
CONSENT_PRIVACY_MODE=demo_foundation
