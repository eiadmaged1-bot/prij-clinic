generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  code           String   @unique
  addressSummary String?
  phone          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  users                User[]
  userRoles            UserRole[]
  auditLogs            AuditLog[]
  patients             Patient[]
  appointments         Appointment[]
  queueTickets         QueueTicket[]
  encounters           Encounter[]
  reports              Report[]
  investigationResults InvestigationResult[]
  patientDocuments     PatientDocument[]
  clinicDepartments    ClinicDepartment[]
  referrals            Referral[]
  patientTasks         PatientTask[]
  patientInternalNotes PatientInternalNote[]
  pregnancies          Pregnancy[]
  gynecologyVisits     GynecologyVisit[]
  antenatalVisits      AntenatalVisit[]
  obUltrasounds        ObUltrasound[]
  invoices             Invoice[]
  payments             Payment[]
  aiDrafts             AiDraft[]

  @@index([status])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  loginId          String?   @unique
  displayName      String
  status           String
  passwordHash     String?
  branchId         String?   @db.Uuid
  permissionPreset String    @default("advanced")
  protectedAccount Boolean   @default(false)
  doctorColor      String?
  doctorShortLabel String?
  createdByUserId  String?   @db.Uuid
  lastLoginAt      DateTime? @db.Timestamptz(3)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  preferences UserPreference?

  branch                             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser                      User?                       @relation("UsersCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                       User[]                      @relation("UsersCreatedBy")
  userRoles                          UserRole[]                  @relation("UserRolesUser")
  assignedRoles                      UserRole[]                  @relation("UserRolesCreatedBy")
  permissionOverrides                UserPermissionOverride[]    @relation("UserPermissionOverridesUser")
  grantedPermissionOverrides         UserPermissionOverride[]    @relation("UserPermissionOverridesGrantedBy")
  roleGrants                         RolePermission[]            @relation("RolePermissionsCreatedBy")
  auditLogs                          AuditLog[]                  @relation("AuditLogsActor")
  createdPatients                    Patient[]                   @relation("PatientsCreatedBy")
  doctorAppointments                 Appointment[]               @relation("AppointmentsDoctor")
  createdAppointments                Appointment[]               @relation("AppointmentsCreatedBy")
  doctorEncounters                   Encounter[]                 @relation("EncountersDoctor")
  startedEncounters                  Encounter[]                 @relation("EncountersStartedBy")
  signedEncounters                   Encounter[]                 @relation("EncountersSignedBy")
  voidedEncounters                   Encounter[]                 @relation("EncountersVoidedBy")
  doctorPrescriptions                Prescription[]              @relation("PrescriptionsDoctor")
  createdPatientHistorySheets        PatientHistorySheet[]       @relation("PatientHistorySheetsCreatedBy")
  updatedPatientHistorySheets        PatientHistorySheet[]       @relation("PatientHistorySheetsUpdatedBy")
  doctorInvestigationOrders          InvestigationOrder[]        @relation("InvestigationOrdersDoctor")
  uploadedReports                    Report[]                    @relation("ReportsUploadedBy")
  reviewedReports                    Report[]                    @relation("ReportsReviewedBy")
  createdPregnancies                 Pregnancy[]                 @relation("PregnanciesCreatedBy")
  createdGynecologyVisits            GynecologyVisit[]           @relation("GynecologyVisitsCreatedBy")
  createdPreviousPregnancies         PreviousPregnancy[]         @relation("PreviousPregnanciesCreatedBy")
  createdPregnancyFetuses            PregnancyFetus[]            @relation("PregnancyFetusesCreatedBy")
  createdObUltrasounds               ObUltrasound[]              @relation("ObUltrasoundsCreatedBy")
  reviewedObUltrasounds              ObUltrasound[]              @relation("ObUltrasoundsReviewedBy")
  createdInvoices                    Invoice[]                   @relation("InvoicesCreatedBy")
  issuedInvoices                     Invoice[]                   @relation("InvoicesIssuedBy")
  voidedInvoices                     Invoice[]                   @relation("InvoicesVoidedBy")
  recordedPayments                   Payment[]                   @relation("PaymentsRecordedBy")
  reversedPayments                   Payment[]                   @relation("PaymentsReversedBy")
  requestedAiDrafts                  AiDraft[]                   @relation("AiDraftsRequestedBy")
  reviewedAiDrafts                   AiDraft[]                   @relation("AiDraftsReviewedBy")
  importedGuidelineDocuments         GuidelineDocument[]         @relation("GuidelineDocumentsImportedBy")
  reviewedGuidelineDocuments         GuidelineDocument[]         @relation("GuidelineDocumentsReviewedBy")
  requestedGuidelineImportJobs       GuidelineImportJob[]        @relation("GuidelineImportJobsRequestedBy")
  guidelineReviewDecisions           GuidelineReviewDecision[]   @relation("GuidelineReviewDecisionsDecidedBy")
  guidelineQueryLogs                 GuidelineQueryLog[]         @relation("GuidelineQueryLogsUser")
  createdManagementSnapshots         AIManagementSnapshot[]      @relation("AIManagementSnapshotsCreatedBy")
  reviewedManagementSnapshots        AIManagementSnapshot[]      @relation("AIManagementSnapshotsReviewedBy")
  approvedClinicalMemories           PatientClinicalMemory[]     @relation("PatientClinicalMemoriesApprovedBy")
  capturedConsentRecords             ConsentRecord[]             @relation("ConsentRecordsCapturedBy")
  updatedSystemSettings              SystemSetting[]             @relation("SystemSettingsUpdatedBy")
  calculatedPatientCalculations      PatientCalculation[]        @relation("PatientCalculationsCalculatedBy")
  reviewedPatientCalculations        PatientCalculation[]        @relation("PatientCalculationsReviewedBy")
  createdPregnancyDatingAssessments  PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsCreatedBy")
  reviewedPregnancyDatingAssessments PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsReviewedBy")
  lockedPregnancyDatingAssessments   PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsLockedBy")
  reviewedMedicationSafetyProfiles   MedicationSafetyProfile[]   @relation("MedicationSafetyProfilesReviewedBy")
  decidedCareAssistFindings          CareAssistFinding[]         @relation("CareAssistFindingsDecidedBy")
  careAssistDecisions                CareAssistDecision[]        @relation("CareAssistDecisionsDecidedBy")
  staffConversationParticipants      StaffConversationParticipant[]
  sentStaffMessages                  StaffMessage[]              @relation("StaffMessagesSender")
  staffMessageReceipts               StaffMessageReceipt[]
  createdClinicalPhases              PatientClinicalPhase[]      @relation("ClinicalPhasesCreatedBy")
  createdInfertilityEpisodes         InfertilityEpisode[]        @relation("InfertilityEpisodesCreatedBy")
  createdOvulationCycles             OvulationInductionCycle[]   @relation("OvulationCyclesCreatedBy")
  createdFollicularMonitoringVisits  FollicularMonitoringVisit[] @relation("FollicularMonitoringCreatedBy")
  createdEstradiolResults            EstradiolResult[]           @relation("EstradiolResultsCreatedBy")
  investigationFavorites             InvestigationFavorite[]
  updatedVisitPriceSettings          VisitPriceAuditSetting[]    @relation("VisitPriceSettingsUpdatedBy")
  createdPatientClinicalTags         PatientClinicalTag[]        @relation("PatientClinicalTagsCreatedBy")
  reviewedExternalSubmissions        ExternalPatientSubmission[] @relation("ExternalSubmissionsReviewedBy")
  authSessions                       AuthSession[]

  @@index([branchId])
  @@index([createdByUserId])
  @@index([protectedAccount])
  @@index([status])
}

enum InterfaceMode {
  OPTIMIZED
  MINIMALISTIC
}

enum DensityMode {
  COMPACT
  COMFORTABLE
  LARGE
}

enum MobileNavigationMode {
  AUTO
  BOTTOM_NAV
  DRAWER
}

model UserPreference {
  userId               String               @id @db.Uuid
  interfaceMode        InterfaceMode        @default(OPTIMIZED)
  densityMode          DensityMode          @default(COMFORTABLE)
  mobileNavigationMode MobileNavigationMode @default(AUTO)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConsentType {
  treatment
  communication
  report_storage
  ai_processing
  data_sharing
}

enum ConsentStatus {
  granted
  declined
  withdrawn
  unknown
}

enum PatientStatus {
  active
  inactive
  archived
}

enum PatientType {
  OB
  GYN
  INFERTILITY
  WOMEN_HEALTH
  GENERAL
}

enum ClinicalPhaseType {
  infertility
  pregnancy
  gynecology
  postpartum
  general
  other
}

enum ClinicalPhaseStatus {
  active
  completed
  archived
}

enum InfertilityType {
  primary
  secondary
  unknown
}

enum InfertilityKnownFactor {
  ovulatory
  tubal
  male_factor
  unexplained
  endometriosis
  pcos
  mixed
  unknown
}

enum InfertilityEpisodeStatus {
  active
  completed
  archived
}

enum OvulationInductionMethod {
  tablets
  injections
  combined
  other
}

enum OvulationInductionOutcome {
  ongoing
  ovulation_confirmed
  no_response
  cancelled
  pregnancy
  failed
  unknown
}

enum InvestigationRequestedStatus {
  requested
  not_requested
  not_yet
  unknown
}

enum EstradiolRequiredStatus {
  required
  not_required
  not_yet
  unknown
}

enum SexualActivityStatus {
  not_sexually_active
  sexually_active
  prefer_not_to_say
  unknown
}

enum AppointmentStatus {
  booked
  rescheduled
  cancelled
  completed
  no_show
}

enum QueueTicketStatus {
  waiting
  called
  completed
  cancelled
}

enum QueuePriority {
  routine
  priority
}

enum VisitType {
  kashf
  recheck
  consultation
  urgent_kashf
}

model Patient {
  id                  String        @id @default(uuid()) @db.Uuid
  branchId            String?       @db.Uuid
  medicalRecordNumber String        @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?     @db.Date
  sex                 String?
  phone               String?
  email               String?
  status              PatientStatus @default(active)
  patientType         PatientType   @default(GENERAL)
  sexualActivityStatus SexualActivityStatus @default(unknown)
  notes               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  createdByUserId     String?       @db.Uuid

  branch                    Branch?                           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser             User?                             @relation("PatientsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointments              Appointment[]
  queueTickets              QueueTicket[]
  encounters                Encounter[]
  patientIntakes            PatientIntake[]
  prescriptions             Prescription[]
  historySheets             PatientHistorySheet[]
  operationHistoryItems     PatientOperationHistoryItem[]
  medicationHistoryItems    PatientMedicationHistoryItem[]
  investigationHistoryItems PatientInvestigationHistoryItem[]
  investigationOrders       InvestigationOrder[]
  reports                   Report[]
  investigationResults      InvestigationResult[]
  patientDocuments          PatientDocument[]
  referrals                 Referral[]
  patientTasks              PatientTask[]
  patientInternalNotes      PatientInternalNote[]
  pregnancies               Pregnancy[]
  gynecologyVisits          GynecologyVisit[]
  previousPregnancies       PreviousPregnancy[]
  antenatalVisits           AntenatalVisit[]
  obUltrasounds             ObUltrasound[]
  invoices                  Invoice[]
  payments                  Payment[]
  aiDrafts                  AiDraft[]
  aiManagementSnapshots     AIManagementSnapshot[]
  clinicalMemories          PatientClinicalMemory[]
  consentRecords            ConsentRecord[]
  patientMedications        PatientMedication[]
  patientAllergies          PatientAllergy[]
  clinicalTags              PatientClinicalTag[]
  externalSubmissionsCreated ExternalPatientSubmission[] @relation("ExternalSubmissionCreatedPatient")
  externalSubmissionsAttached ExternalPatientSubmission[] @relation("ExternalSubmissionAttachedPatient")
  medicationSafetyChecks    MedicationSafetyCheck[]
  calculations              PatientCalculation[]
  datingAssessments         PregnancyDatingAssessment[]
  clinicalPhases            PatientClinicalPhase[]
  infertilityEpisodes       InfertilityEpisode[]
  ovulationInductionCycles  OvulationInductionCycle[]
  follicularMonitoringVisits FollicularMonitoringVisit[]
  estradiolResults          EstradiolResult[]
  careAssistFindings        CareAssistFinding[]
  staffConversations        StaffConversation[]
  staffMessages             StaffMessage[]

  @@index([branchId])
  @@index([status])
  @@index([patientType])
  @@index([lastName, firstName])
}

model ConsentRecord {
  id                    String                 @id @default(uuid()) @db.Uuid
  patientId             String                 @db.Uuid
  consentType           ConsentType
  status                ConsentStatus          @default(unknown)
  templateId            String?                @db.Uuid
  signedByName          String?
  relationshipToPatient String?
  guardianName          String?
  witnessName           String?
  signatureStatus       ConsentSignatureStatus @default(not_required)
  signedAt              DateTime?              @db.Timestamptz(3)
  legalNotes            String?
  documentId            String?                @db.Uuid
  reviewedByUserId      String?                @db.Uuid
  reviewedAt            DateTime?              @db.Timestamptz(3)
  capturedByUserId      String?                @db.Uuid
  capturedAt            DateTime               @default(now()) @db.Timestamptz(3)
  notes                 String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  template       ConsentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  capturedByUser User?            @relation("ConsentRecordsCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, consentType])
  @@index([templateId])
  @@index([status])
  @@index([signatureStatus])
  @@index([capturedAt])
}

enum ConsentSignatureStatus {
  not_required
  pending
  captured_demo
  declined
  withdrawn
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String?           @db.Uuid
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(booked)
  appointmentType String?
  source          String?
  cancellationReason String?
  noShowReason    String?
  notes           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdByUserId String?           @db.Uuid

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        User?         @relation("AppointmentsDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdByUser User?         @relation("AppointmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueTickets  QueueTicket[]
  encounters    Encounter[]
  invoices      Invoice[]

  @@index([branchId, startAt])
  @@index([patientId, startAt])
  @@index([doctorId, startAt])
  @@index([status])
}

model QueueTicket {
  id            String            @id @default(uuid()) @db.Uuid
  branchId      String            @db.Uuid
  patientId     String            @db.Uuid
  appointmentId String?           @db.Uuid
  queueNumber   Int
  queueDate     DateTime          @db.Date
  status        QueueTicketStatus @default(waiting)
  priority      QueuePriority     @default(routine)
  visitType     VisitType
  checkedInAt   DateTime          @default(now()) @db.Timestamptz(3)
  receptionistUserId String?      @db.Uuid
  receptionistDisplayNameSnapshot String?
  checkInMethod String?
  visitTypeChangedByUserId String? @db.Uuid
  visitTypeChangeReason String?
  calledAt      DateTime?         @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  cancelledAt   DateTime?         @db.Timestamptz(3)
  cancellationReason String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  staffConversations StaffConversation[]
  staffMessages      StaffMessage[]

  @@unique([branchId, queueDate, queueNumber])
  @@index([branchId, checkedInAt])
  @@index([branchId, queueDate, status])
  @@index([branchId, queueDate, visitType])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
}

enum EncounterStatus {
  draft
  signed
  voided
}

enum PrescriptionStatus {
  draft
  signed
  cancelled
  voided
}

enum InvestigationOrderStatus {
  requested
  scheduled
  pending_payment
  sent
  sample_collected
  in_progress
  sent_out
  result_pending
  result_ready
  result_received
  reviewed
  cancelled
  voided
}

enum InvestigationPriority {
  routine
  urgent
  stat
}

enum InvestigationCategory {
  laboratory
  radiology
  ultrasound
  pathology
  cytology
  procedure
  other
}

enum InvestigationOrderSource {
  doctor
  reception
  patient_file
  external_referral
}

enum InvestigationBillingStatus {
  not_billable
  pending_invoice
  invoiced
  paid
  waived_demo
}

enum InvestigationResultReviewStatus {
  pending_review
  reviewed
  needs_follow_up
  amended
  voided
}

enum PatientIntakeStatus {
  draft_by_secretary
  waiting_for_doctor_review
  reviewed_by_doctor
  signed_locked
}

enum PatientIntakeType {
  new_patient
  follow_up
  emergency
  pregnancy
  gynecology
  ultrasound
  fertility
}

enum PrescriptionSourceType {
  manual
  template
  doctor_shortcut
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @db.Uuid
  patientId      String          @db.Uuid
  appointmentId  String?         @db.Uuid
  doctorId       String          @db.Uuid
  startedByUserId String?        @db.Uuid
  doctorDisplayNameSnapshot String?
  doctorColorSnapshot String?
  startedAt      DateTime?       @db.Timestamptz(3)
  status         EncounterStatus @default(draft)
  chiefComplaint String?
  historyText    String?
  examText       String?
  assessmentText String?
  planText       String?
  doctorReviewedIntake Boolean       @default(false)
  doctorReviewStatus   String?
  historyClarification String?
  examinationJson      Json?
  ultrasoundFindingsJson Json?
  clinicalImpression   String?
  riskClassification   String?
  followUpJson         Json?
  signedAt       DateTime?       @db.Timestamptz(3)
  signedByUserId String?         @db.Uuid
  voidedAt       DateTime?       @db.Timestamptz(3)
  voidedByUserId String?         @db.Uuid
  voidReason     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment           Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor                User                   @relation("EncountersDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  startedByUser         User?                  @relation("EncountersStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  signedByUser          User?                  @relation("EncountersSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  voidedByUser          User?                  @relation("EncountersVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  prescriptions         Prescription[]
  investigationOrders   InvestigationOrder[]
  patientIntakes        PatientIntake[]
  reports               Report[]
  gynecologyVisits      GynecologyVisit[]
  obUltrasounds         ObUltrasound[]
  aiDrafts              AiDraft[]
  aiManagementSnapshots AIManagementSnapshot[]
  careAssistFindings    CareAssistFinding[]
  invoices              Invoice[]
  staffConversations    StaffConversation[]
  staffMessages         StaffMessage[]

  @@index([branchId])
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([startedByUserId, startedAt])
  @@index([appointmentId])
  @@index([status])
}

model StaffConversation {
  id          String    @id @default(uuid()) @db.Uuid
  title       String?
  kind        String    @default("direct")
  patientId   String?   @db.Uuid
  queueTicketId String? @db.Uuid
  encounterId String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  queueTicket QueueTicket? @relation(fields: [queueTicketId], references: [id], onDelete: SetNull)
  encounter   Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  participants StaffConversationParticipant[]
  messages     StaffMessage[]

  @@index([kind, updatedAt])
  @@index([patientId])
  @@index([queueTicketId])
  @@index([encounterId])
}

model StaffConversationParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  roleSnapshot   String?
  joinedAt       DateTime @default(now()) @db.Timestamptz(3)

  conversation StaffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model StaffMessage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderUserId   String    @db.Uuid
  body           String
  messageType    String    @default("text")
  patientId      String?   @db.Uuid
  queueTicketId  String?   @db.Uuid
  encounterId    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  editedAt       DateTime? @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  conversation StaffConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("StaffMessagesSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  patient      Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  queueTicket  QueueTicket?      @relation(fields: [queueTicketId], references: [id], onDelete: SetNull)
  encounter    Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  receipts     StaffMessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
  @@index([patientId])
}

model StaffMessageReceipt {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @db.Uuid
  userId    String    @db.Uuid
  deliveredAt DateTime? @db.Timestamptz(3)
  seenAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  message StaffMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, seenAt])
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String?            @db.Uuid
  encounterId String?            @db.Uuid
  doctorId    String             @db.Uuid
  status      PrescriptionStatus @default(draft)
  sourceType  PrescriptionSourceType @default(manual)
  printSnapshotJson Json?
  linkedFollowUpHintsJson Json?
  notes       String?
  signedAt    DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  patient            Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter          Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  doctor             User                @relation("PrescriptionsDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  items              PrescriptionItem[]
  careAssistFindings CareAssistFinding[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([doctorId, createdAt])
  @@index([status])
}

model PatientIntake {
  id                  String              @id @default(uuid()) @db.Uuid
  patientId           String              @db.Uuid
  encounterId         String?             @db.Uuid
  status              PatientIntakeStatus @default(draft_by_secretary)
  intakeType          PatientIntakeType   @default(new_patient)
  patientReportedJson Json?
  administrativeJson  Json?
  vitalsJson          Json?
  obsIntakeJson       Json?
  gynIntakeJson       Json?
  redFlagsJson        Json?
  attributionJson     Json?
  enteredByUserId     String?             @db.Uuid
  reviewedByDoctorId  String?             @db.Uuid
