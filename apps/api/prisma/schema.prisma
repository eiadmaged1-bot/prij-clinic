  finishedAt        DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)

  source          GuidelineSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  document        GuidelineDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  requestedByUser User?              @relation("GuidelineImportJobsRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([jobType])
  @@index([status])
  @@index([sourceId])
  @@index([documentId])
}

model GuidelineUpdateCheck {
  id              String                     @id @default(uuid()) @db.Uuid
  sourceId        String?                    @db.Uuid
  documentId      String?                    @db.Uuid
  status          GuidelineUpdateCheckStatus
  checkedUrl      String?
  detectedTitle   String?
  detectedVersion String?
  detectedDate    DateTime?                  @db.Date
  message         String?
  resultJson      Json?
  checkedAt       DateTime                   @default(now()) @db.Timestamptz(3)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)

  source   GuidelineSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  document GuidelineDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([documentId])
  @@index([status])
  @@index([checkedAt])
}

model GuidelineReviewDecision {
  id              String                       @id @default(uuid()) @db.Uuid
  documentId      String                       @db.Uuid
  versionId       String?                      @db.Uuid
  decision        GuidelineReviewDecisionValue
  reason          String?
  decidedByUserId String                       @db.Uuid
  decidedAt       DateTime                     @default(now()) @db.Timestamptz(3)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)

  document      GuidelineDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       GuidelineVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  decidedByUser User              @relation("GuidelineReviewDecisionsDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([versionId])
  @@index([decision])
  @@index([decidedByUserId])
}

model GuidelineQueryLog {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  query         String
  specialty     String?
  topic         String?
  answerMode    GuidelineAnswerMode
  resultCount   Int
  citedChunkIds Json
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  user User @relation("GuidelineQueryLogsUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([specialty])
  @@index([topic])
  @@index([answerMode])
}

model ClinicalProtocol {
  id                   String   @id @default(cuid())
  code                 String   @unique
  title                String
  specialtyGroup       String
  condition            String
  aliases              Json
  bodySystem           String?
  clinicalArea         String?
  protocolType         String   @default("management_snapshot")
  implementationStatus String   @default("catalog_only")
  riskLevel            String   @default("medium")
  sourceName           String
  sourceYear           Int?
  sourceUrl            String?
  sourceVersion        String?
  contentJson          Json
  safetyJson           Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  managementSnapshots AIManagementSnapshot[]

  @@index([specialtyGroup])
  @@index([condition])
  @@index([implementationStatus])
  @@index([riskLevel])
}

model AIManagementSnapshot {
  id               String    @id @default(cuid())
  patientId        String    @db.Uuid
  encounterId      String?   @db.Uuid
  protocolId       String?
  diagnosisText    String
  clinicalGoal     String?
  inputContextJson Json
  outputJson       Json
  status           String    @default("draft")
  doctorDecision   String?
  doctorEditedPlan String?
  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(3)
  createdByUserId  String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter        Encounter?              @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  protocol         ClinicalProtocol?       @relation(fields: [protocolId], references: [id], onDelete: SetNull)
  createdByUser    User                    @relation("AIManagementSnapshotsCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByUser   User?                   @relation("AIManagementSnapshotsReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  clinicalMemories PatientClinicalMemory[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([protocolId])
  @@index([status])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
}

model PatientClinicalMemory {
  id               String   @id @default(cuid())
  patientId        String   @db.Uuid
  memoryType       String
  title            String
  valueJson        Json
  sourceSnapshotId String?
  approvedByUserId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sourceSnapshot AIManagementSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  approvedByUser User                  @relation("PatientClinicalMemoriesApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([memoryType])
  @@index([sourceSnapshotId])
  @@index([approvedByUserId])
}

model CalculatorFormula {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  category              String
  specialty             String?
  formulaType           String
  calculationEngineType String
  implementationStatus  String
  sourceName            String
  sourceYear            Int?
  sourceVersion         String?
  sourceUrl             String?
  inputSchemaJson       Json
  outputSchemaJson      Json
  formulaJson           Json
  unitRulesJson         Json?
  limitationsJson       Json?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  calculations      PatientCalculation[]
  datingAssessments PregnancyDatingAssessment[]

  @@index([category])
  @@index([specialty])
  @@index([implementationStatus])
  @@index([active])
}

model PatientCalculation {
  id                 String    @id @default(cuid())
  patientId          String?   @db.Uuid
  pregnancyEpisodeId String?   @db.Uuid
  fetusId            String?   @db.Uuid
  formulaId          String
  calculationType    String
  inputJson          Json
  outputJson         Json
  unitJson           Json?
  calculatedAt       DateTime  @db.Timestamptz(3)
  calculatedByUserId String    @db.Uuid
  reviewedByUserId   String?   @db.Uuid
  reviewedAt         DateTime? @db.Timestamptz(3)
  status             String
  sourceContext      String
  notes              String?
  voidReason         String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  patient          Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  pregnancyEpisode Pregnancy?        @relation(fields: [pregnancyEpisodeId], references: [id], onDelete: SetNull)
  fetus            PregnancyFetus?   @relation(fields: [fetusId], references: [id], onDelete: SetNull)
  formula          CalculatorFormula @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  calculatedByUser User              @relation("PatientCalculationsCalculatedBy", fields: [calculatedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser   User?             @relation("PatientCalculationsReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, calculatedAt])
  @@index([pregnancyEpisodeId])
  @@index([fetusId])
  @@index([formulaId])
  @@index([calculatedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([sourceContext])
}

model PregnancyDatingAssessment {
  id                           String    @id @default(cuid())
  patientId                    String    @db.Uuid
  pregnancyEpisodeId           String    @db.Uuid
  datingSource                 String
  lmpDate                      DateTime? @db.Date
  cycleLengthDays              Int?
  conceptionDate               DateTime? @db.Date
  embryoTransferDate           DateTime? @db.Date
  embryoAgeDays                Int?
  scanDate                     DateTime? @db.Date
  gaWeeks                      Int?
  gaDays                       Int?
  knownEdd                     DateTime? @db.Date
  calculatedEdd                DateTime  @db.Date
  calculatedGaAtAssessmentDays Int?
  discrepancyDays              Int?
  confidenceStatus             String
  isBestObstetricEstimate      Boolean   @default(false)
  isLocked                     Boolean   @default(false)
  lockedByUserId               String?   @db.Uuid
  lockedAt                     DateTime? @db.Timestamptz(3)
  changeReason                 String?
  calculationFormulaId         String?
  inputJson                    Json
  outputJson                   Json
  createdByUserId              String    @db.Uuid
  reviewedByUserId             String?   @db.Uuid
  reviewedAt                   DateTime? @db.Timestamptz(3)
  voidedAt                     DateTime? @db.Timestamptz(3)
  voidReason                   String?
  createdAt                    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(3)

  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancyEpisode   Pregnancy          @relation(fields: [pregnancyEpisodeId], references: [id], onDelete: Restrict)
  calculationFormula CalculatorFormula? @relation(fields: [calculationFormulaId], references: [id], onDelete: SetNull)
  createdByUser      User               @relation("PregnancyDatingAssessmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByUser     User?              @relation("PregnancyDatingAssessmentsReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  lockedByUser       User?              @relation("PregnancyDatingAssessmentsLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([pregnancyEpisodeId, createdAt])
  @@index([datingSource])
  @@index([confidenceStatus])
  @@index([isBestObstetricEstimate])
  @@index([isLocked])
  @@index([calculationFormulaId])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
  @@index([lockedByUserId])
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  riskLevel   String   @default("medium")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@index([riskLevel])
}

model UserPermissionOverride {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  permissionId    String   @db.Uuid
  effect          String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  grantedByUserId String?  @db.Uuid

  user          User       @relation("UserPermissionOverridesUser", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?      @relation("UserPermissionOverridesGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
}

model UserRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  roleId          String   @db.Uuid
  branchId        String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  user          User    @relation("UserRolesUser", fields: [userId], references: [id], onDelete: Cascade)
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch        Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("UserRolesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([branchId])
  @@index([roleId])
  @@index([createdByUserId])
}

model RolePermission {
  roleId          String   @db.Uuid
  permissionId    String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("RolePermissionsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([createdByUserId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?  @db.Uuid
  metadataJson Json?
  ipAddress    String?  @db.Inet
  userAgent    String?
  branchId     String?  @db.Uuid
  severity     String   @default("low")
  reason       String?
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actorUser User?   @relation("AuditLogsActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([branchId, createdAt])
  @@index([action])
  @@index([severity, createdAt])
}
