generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  code           String     @unique
  addressSummary String?
  phone          String?
  status         String     @default("active")
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  users          User[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  patients       Patient[]
  appointments   Appointment[]
  queueTickets   QueueTicket[]

  @@index([status])
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  displayName   String
  status        String
  passwordHash  String?
  branchId      String?    @db.Uuid
  lastLoginAt   DateTime?  @db.Timestamptz(3)
  failedLoginCount Int     @default(0)
  lockedUntil   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles     UserRole[] @relation("UserRolesUser")
  assignedRoles UserRole[] @relation("UserRolesCreatedBy")
  roleGrants    RolePermission[] @relation("RolePermissionsCreatedBy")
  auditLogs     AuditLog[] @relation("AuditLogsActor")
  createdPatients Patient[] @relation("PatientsCreatedBy")
  doctorAppointments Appointment[] @relation("AppointmentsDoctor")
  createdAppointments Appointment[] @relation("AppointmentsCreatedBy")

  @@index([branchId])
  @@index([status])
}

enum PatientStatus {
  active
  inactive
  archived
}

enum AppointmentStatus {
  booked
  rescheduled
  cancelled
  completed
  no_show
}

enum QueueTicketStatus {
  waiting
  called
  completed
  cancelled
}

enum QueuePriority {
  routine
  priority
}

model Patient {
  id                  String        @id @default(uuid()) @db.Uuid
  branchId            String?       @db.Uuid
  medicalRecordNumber String        @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?     @db.Date
  sex                 String?
  phone               String?
  email               String?
  status              PatientStatus @default(active)
  notes               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  createdByUserId     String?       @db.Uuid

  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser       User?         @relation("PatientsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointments         Appointment[]
  queueTickets         QueueTicket[]

  @@index([branchId])
  @@index([status])
  @@index([lastName, firstName])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String?           @db.Uuid
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(booked)
  appointmentType String?
  source          String?
  notes           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdByUserId String?           @db.Uuid

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          User?             @relation("AppointmentsDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation("AppointmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueTickets    QueueTicket[]

  @@index([branchId, startAt])
  @@index([patientId, startAt])
  @@index([doctorId, startAt])
  @@index([status])
}

model QueueTicket {
  id             String            @id @default(uuid()) @db.Uuid
  branchId       String            @db.Uuid
  patientId      String            @db.Uuid
  appointmentId  String?           @db.Uuid
  queueNumber    Int
  status         QueueTicketStatus @default(waiting)
  priority       QueuePriority     @default(routine)
  checkedInAt    DateTime          @default(now()) @db.Timestamptz(3)
  calledAt       DateTime?         @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  cancelledAt    DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([branchId, queueNumber, checkedInAt])
  @@index([branchId, checkedInAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  isSystemRole    Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String?
  riskLevel       String           @default("medium")
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([riskLevel])
}

model UserRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  roleId          String   @db.Uuid
  branchId        String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  user            User     @relation("UserRolesUser", fields: [userId], references: [id], onDelete: Cascade)
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUser   User?    @relation("UserRolesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([branchId])
  @@index([roleId])
  @@index([createdByUserId])
}

model RolePermission {
  roleId          String   @db.Uuid
  permissionId    String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser   User?      @relation("RolePermissionsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([createdByUserId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?  @db.Uuid
  metadataJson Json?
  ipAddress    String?  @db.Inet
  userAgent    String?
  branchId     String?  @db.Uuid
  severity     String   @default("low")
  reason       String?
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actorUser    User?    @relation("AuditLogsActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([branchId, createdAt])
  @@index([action])
  @@index([severity, createdAt])
}
