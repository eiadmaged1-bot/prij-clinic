generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  code           String   @unique
  addressSummary String?
  phone          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  users            User[]
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  patients         Patient[]
  appointments     Appointment[]
  queueTickets     QueueTicket[]
  encounters       Encounter[]
  reports          Report[]
  investigationResults InvestigationResult[]
  patientDocuments PatientDocument[]
  clinicDepartments ClinicDepartment[]
  referrals        Referral[]
  patientTasks     PatientTask[]
  patientInternalNotes PatientInternalNote[]
  pregnancies      Pregnancy[]
  gynecologyVisits GynecologyVisit[]
  antenatalVisits  AntenatalVisit[]
  obUltrasounds    ObUltrasound[]
  invoices         Invoice[]
  payments         Payment[]
  aiDrafts         AiDraft[]

  @@index([status])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  loginId          String?   @unique
  displayName      String
  status           String
  passwordHash     String?
  branchId         String?   @db.Uuid
  permissionPreset String    @default("advanced")
  protectedAccount Boolean   @default(false)
  createdByUserId  String?   @db.Uuid
  lastLoginAt      DateTime? @db.Timestamptz(3)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  branch                             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser                      User?                       @relation("UsersCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers                       User[]                      @relation("UsersCreatedBy")
  userRoles                          UserRole[]                  @relation("UserRolesUser")
  assignedRoles                      UserRole[]                  @relation("UserRolesCreatedBy")
  permissionOverrides                UserPermissionOverride[]    @relation("UserPermissionOverridesUser")
  grantedPermissionOverrides         UserPermissionOverride[]    @relation("UserPermissionOverridesGrantedBy")
  roleGrants                         RolePermission[]            @relation("RolePermissionsCreatedBy")
  auditLogs                          AuditLog[]                  @relation("AuditLogsActor")
  createdPatients                    Patient[]                   @relation("PatientsCreatedBy")
  doctorAppointments                 Appointment[]               @relation("AppointmentsDoctor")
  createdAppointments                Appointment[]               @relation("AppointmentsCreatedBy")
  doctorEncounters                   Encounter[]                 @relation("EncountersDoctor")
  signedEncounters                   Encounter[]                 @relation("EncountersSignedBy")
  voidedEncounters                   Encounter[]                 @relation("EncountersVoidedBy")
  doctorPrescriptions                Prescription[]              @relation("PrescriptionsDoctor")
  doctorInvestigationOrders          InvestigationOrder[]        @relation("InvestigationOrdersDoctor")
  uploadedReports                    Report[]                    @relation("ReportsUploadedBy")
  reviewedReports                    Report[]                    @relation("ReportsReviewedBy")
  createdPregnancies                 Pregnancy[]                 @relation("PregnanciesCreatedBy")
  createdGynecologyVisits            GynecologyVisit[]           @relation("GynecologyVisitsCreatedBy")
  createdPreviousPregnancies         PreviousPregnancy[]         @relation("PreviousPregnanciesCreatedBy")
  createdPregnancyFetuses            PregnancyFetus[]            @relation("PregnancyFetusesCreatedBy")
  createdObUltrasounds               ObUltrasound[]              @relation("ObUltrasoundsCreatedBy")
  reviewedObUltrasounds              ObUltrasound[]              @relation("ObUltrasoundsReviewedBy")
  createdInvoices                    Invoice[]                   @relation("InvoicesCreatedBy")
  issuedInvoices                     Invoice[]                   @relation("InvoicesIssuedBy")
  voidedInvoices                     Invoice[]                   @relation("InvoicesVoidedBy")
  recordedPayments                   Payment[]                   @relation("PaymentsRecordedBy")
  reversedPayments                   Payment[]                   @relation("PaymentsReversedBy")
  requestedAiDrafts                  AiDraft[]                   @relation("AiDraftsRequestedBy")
  reviewedAiDrafts                   AiDraft[]                   @relation("AiDraftsReviewedBy")
  importedGuidelineDocuments         GuidelineDocument[]         @relation("GuidelineDocumentsImportedBy")
  reviewedGuidelineDocuments         GuidelineDocument[]         @relation("GuidelineDocumentsReviewedBy")
  requestedGuidelineImportJobs       GuidelineImportJob[]        @relation("GuidelineImportJobsRequestedBy")
  guidelineReviewDecisions           GuidelineReviewDecision[]   @relation("GuidelineReviewDecisionsDecidedBy")
  guidelineQueryLogs                 GuidelineQueryLog[]         @relation("GuidelineQueryLogsUser")
  createdManagementSnapshots         AIManagementSnapshot[]      @relation("AIManagementSnapshotsCreatedBy")
  reviewedManagementSnapshots        AIManagementSnapshot[]      @relation("AIManagementSnapshotsReviewedBy")
  approvedClinicalMemories           PatientClinicalMemory[]     @relation("PatientClinicalMemoriesApprovedBy")
  capturedConsentRecords             ConsentRecord[]             @relation("ConsentRecordsCapturedBy")
  updatedSystemSettings              SystemSetting[]             @relation("SystemSettingsUpdatedBy")
  calculatedPatientCalculations      PatientCalculation[]        @relation("PatientCalculationsCalculatedBy")
  reviewedPatientCalculations        PatientCalculation[]        @relation("PatientCalculationsReviewedBy")
  createdPregnancyDatingAssessments  PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsCreatedBy")
  reviewedPregnancyDatingAssessments PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsReviewedBy")
  lockedPregnancyDatingAssessments   PregnancyDatingAssessment[] @relation("PregnancyDatingAssessmentsLockedBy")

  @@index([branchId])
  @@index([createdByUserId])
  @@index([protectedAccount])
  @@index([status])
}

enum ConsentType {
  treatment
  communication
  report_storage
  ai_processing
  data_sharing
}

enum ConsentStatus {
  granted
  declined
  withdrawn
  unknown
}

enum PatientStatus {
  active
  inactive
  archived
}

enum PatientType {
  OB
  GYN
  WOMEN_HEALTH
  GENERAL
}

enum AppointmentStatus {
  booked
  rescheduled
  cancelled
  completed
  no_show
}

enum QueueTicketStatus {
  waiting
  called
  completed
  cancelled
}

enum QueuePriority {
  routine
  priority
}

model Patient {
  id                  String        @id @default(uuid()) @db.Uuid
  branchId            String?       @db.Uuid
  medicalRecordNumber String        @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?     @db.Date
  sex                 String?
  phone               String?
  email               String?
  status              PatientStatus @default(active)
  patientType         PatientType   @default(GENERAL)
  notes               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  createdByUserId     String?       @db.Uuid

  branch                 Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser          User?                       @relation("PatientsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointments           Appointment[]
  queueTickets           QueueTicket[]
  encounters             Encounter[]
  prescriptions          Prescription[]
  investigationOrders    InvestigationOrder[]
  reports                Report[]
  investigationResults   InvestigationResult[]
  patientDocuments       PatientDocument[]
  referrals              Referral[]
  patientTasks           PatientTask[]
  patientInternalNotes   PatientInternalNote[]
  pregnancies            Pregnancy[]
  gynecologyVisits       GynecologyVisit[]
  previousPregnancies    PreviousPregnancy[]
  antenatalVisits        AntenatalVisit[]
  obUltrasounds          ObUltrasound[]
  invoices               Invoice[]
  payments               Payment[]
  aiDrafts               AiDraft[]
  aiManagementSnapshots  AIManagementSnapshot[]
  clinicalMemories       PatientClinicalMemory[]
  consentRecords         ConsentRecord[]
  patientMedications     PatientMedication[]
  patientAllergies       PatientAllergy[]
  medicationSafetyChecks MedicationSafetyCheck[]
  calculations           PatientCalculation[]
  datingAssessments      PregnancyDatingAssessment[]

  @@index([branchId])
  @@index([status])
  @@index([patientType])
  @@index([lastName, firstName])
}

model ConsentRecord {
  id               String        @id @default(uuid()) @db.Uuid
  patientId        String        @db.Uuid
  consentType      ConsentType
  status           ConsentStatus @default(unknown)
  templateId       String?       @db.Uuid
  signedByName     String?
  relationshipToPatient String?
  guardianName     String?
  witnessName      String?
  signatureStatus  ConsentSignatureStatus @default(not_required)
  signedAt         DateTime?     @db.Timestamptz(3)
  legalNotes       String?
  documentId       String?       @db.Uuid
  reviewedByUserId String?       @db.Uuid
  reviewedAt       DateTime?     @db.Timestamptz(3)
  capturedByUserId String?       @db.Uuid
  capturedAt       DateTime      @default(now()) @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  patient        Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  template       ConsentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  capturedByUser User?   @relation("ConsentRecordsCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)

  @@index([patientId, consentType])
  @@index([templateId])
  @@index([status])
  @@index([signatureStatus])
  @@index([capturedAt])
}

enum ConsentSignatureStatus {
  not_required
  pending
  captured_demo
  declined
  withdrawn
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String?           @db.Uuid
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(booked)
  appointmentType String?
  source          String?
  notes           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdByUserId String?           @db.Uuid

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        User?         @relation("AppointmentsDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdByUser User?         @relation("AppointmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueTickets  QueueTicket[]
  encounters    Encounter[]

  @@index([branchId, startAt])
  @@index([patientId, startAt])
  @@index([doctorId, startAt])
  @@index([status])
}

model QueueTicket {
  id            String            @id @default(uuid()) @db.Uuid
  branchId      String            @db.Uuid
  patientId     String            @db.Uuid
  appointmentId String?           @db.Uuid
  queueNumber   Int
  queueDate     DateTime          @db.Date
  status        QueueTicketStatus @default(waiting)
  priority      QueuePriority     @default(routine)
  checkedInAt   DateTime          @default(now()) @db.Timestamptz(3)
  calledAt      DateTime?         @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  cancelledAt   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([branchId, queueDate, queueNumber])
  @@index([branchId, checkedInAt])
  @@index([branchId, queueDate, status])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
}

enum EncounterStatus {
  draft
  signed
  voided
}

enum PrescriptionStatus {
  draft
  signed
  cancelled
  voided
}

enum InvestigationOrderStatus {
  requested
  scheduled
  pending_payment
  sent
  sample_collected
  in_progress
  sent_out
  result_pending
  result_ready
  result_received
  reviewed
  cancelled
  voided
}

enum InvestigationPriority {
  routine
  urgent
  stat
}

enum InvestigationCategory {
  laboratory
  radiology
  ultrasound
  pathology
  cytology
  procedure
  other
}

enum InvestigationOrderSource {
  doctor
  reception
  patient_file
  external_referral
}

enum InvestigationBillingStatus {
  not_billable
  pending_invoice
  invoiced
  paid
  waived_demo
}

enum InvestigationResultReviewStatus {
  pending_review
  reviewed
  needs_follow_up
  amended
  voided
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @db.Uuid
  patientId      String          @db.Uuid
  appointmentId  String?         @db.Uuid
  doctorId       String          @db.Uuid
  status         EncounterStatus @default(draft)
  chiefComplaint String?
  historyText    String?
  examText       String?
  assessmentText String?
  planText       String?
  signedAt       DateTime?       @db.Timestamptz(3)
  signedByUserId String?         @db.Uuid
  voidedAt       DateTime?       @db.Timestamptz(3)
  voidedByUserId String?         @db.Uuid
  voidReason     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment           Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor                User                   @relation("EncountersDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  signedByUser          User?                  @relation("EncountersSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  voidedByUser          User?                  @relation("EncountersVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  prescriptions         Prescription[]
  investigationOrders   InvestigationOrder[]
  reports               Report[]
  gynecologyVisits      GynecologyVisit[]
  obUltrasounds         ObUltrasound[]
  aiDrafts              AiDraft[]
  aiManagementSnapshots AIManagementSnapshot[]

  @@index([branchId])
  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String             @db.Uuid
  encounterId String?            @db.Uuid
  doctorId    String             @db.Uuid
  status      PrescriptionStatus @default(draft)
  notes       String?
  signedAt    DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  patient   Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  doctor    User               @relation("PrescriptionsDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  items     PrescriptionItem[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([doctorId, createdAt])
  @@index([status])
}

model PrescriptionItem {
  id                  String  @id @default(uuid()) @db.Uuid
  prescriptionId      String  @db.Uuid
  medicationName      String
  dose                String?
  route               String?
  frequency           String?
  duration            String?
  instructions        String?
  medicationProductId String? @db.Uuid
  drugMarketVariantId String? @db.Uuid
  genericName         String?
  brandName           String?
  tradeName           String?
  strengthText        String?
  dosageForm          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([medicationProductId])
  @@index([drugMarketVariantId])
}

model DrugFamily {
  id                   String   @id @default(uuid()) @db.Uuid
  code                 String   @unique
  displayName          String
  aliases              Json?
  normalizedSearchText String
  therapeuticClass     String?
  pharmacologicClass   String?
  restrictedFlag       Boolean  @default(false)
  verificationStatus   String   @default("catalog_only")
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  memberships MedicationFamilyMembership[]

  @@index([code])
  @@index([displayName])
  @@index([normalizedSearchText])
  @@index([verificationStatus])
}

model MedicationIngredient {
  id                   String   @id @default(uuid()) @db.Uuid
  genericName          String
  scientificName       String?
  normalizedSearchText String
  therapeuticClass     String?
  pharmacologicClass   String?
  atcCode              String?
  rxCui                String?
  pregnancyReviewFlag  Boolean  @default(false)
  lactationReviewFlag  Boolean  @default(false)
  renalReviewFlag      Boolean  @default(false)
  hepaticReviewFlag    Boolean  @default(false)
  verificationStatus   String   @default("needs_review")
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  familyMemberships MedicationFamilyMembership[]
  products          MedicationProduct[]
  labelSections     MedicationLabelSection[]

  @@index([genericName])
  @@index([normalizedSearchText])
  @@index([atcCode])
  @@index([rxCui])
  @@index([verificationStatus])
}

model MedicationFamilyMembership {
  id           String   @id @default(uuid()) @db.Uuid
  ingredientId String   @db.Uuid
  familyId     String   @db.Uuid
  sourceStatus String   @default("catalog_only")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  ingredient MedicationIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  family     DrugFamily           @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, familyId])
  @@index([familyId])
  @@index([sourceStatus])
}

model MedicationProduct {
  id                   String   @id @default(uuid()) @db.Uuid
  ingredientId         String?  @db.Uuid
  genericName          String
  brandName            String?
  normalizedSearchText String
  route                String?
  dosageForm           String?
  strengthText         String?
  verificationStatus   String   @default("needs_review")
  sourceId             String?  @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  ingredient    MedicationIngredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  labelSections MedicationLabelSection[]

  @@index([ingredientId])
  @@index([genericName])
  @@index([brandName])
  @@index([normalizedSearchText])
  @@index([dosageForm])
  @@index([strengthText])
  @@index([verificationStatus])
}

model MedicationLabelSection {
  id                 String   @id @default(uuid()) @db.Uuid
  ingredientId       String?  @db.Uuid
  productId          String?  @db.Uuid
  sectionType        String
  title              String
  summaryText        String
  sourceId           String?  @db.Uuid
  verificationStatus String   @default("needs_review")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  ingredient MedicationIngredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product    MedicationProduct?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([productId])
  @@index([sectionType])
  @@index([verificationStatus])
}

model MedicationInteractionRule {
  id                    String   @id @default(uuid()) @db.Uuid
  ruleType              String
  primaryIngredientId   String?  @db.Uuid
  secondaryIngredientId String?  @db.Uuid
  primaryFamilyId       String?  @db.Uuid
  secondaryFamilyId     String?  @db.Uuid
  herbalProductId       String?  @db.Uuid
  severity              String   @default("moderate")
  alertTitle            String
  alertSummary          String
  evidenceSource        String?
  verificationStatus    String   @default("needs_review")
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@index([ruleType])
  @@index([severity])
  @@index([primaryIngredientId])
  @@index([secondaryIngredientId])
  @@index([primaryFamilyId])
  @@index([secondaryFamilyId])
  @@index([herbalProductId])
  @@index([verificationStatus])
}

model HerbalProduct {
  id                   String   @id @default(uuid()) @db.Uuid
  commonName           String
  botanicalName        String?
  aliases              Json?
  normalizedSearchText String
  cautionSummary       String?
  pregnancyReviewFlag  Boolean  @default(true)
  lactationReviewFlag  Boolean  @default(true)
  verificationStatus   String   @default("needs_review")
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@index([commonName])
  @@index([botanicalName])
  @@index([normalizedSearchText])
  @@index([verificationStatus])
}

model PatientAllergy {
  id                  String   @id @default(uuid()) @db.Uuid
  patientId           String   @db.Uuid
  allergyType         String
  medicationProductId String?  @db.Uuid
  ingredientId        String?  @db.Uuid
  familyId            String?  @db.Uuid
  herbalProductId     String?  @db.Uuid
  displayName         String
  reactionText        String?
  severity            String   @default("unknown")
  status              String   @default("active")
  recordedByUserId    String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([ingredientId])
  @@index([familyId])
  @@index([herbalProductId])
}

model PatientMedication {
  id                  String    @id @default(uuid()) @db.Uuid
  patientId           String    @db.Uuid
  medicationType      String    @default("prescription")
  medicationProductId String?   @db.Uuid
  drugMarketVariantId String?   @db.Uuid
  herbalProductId     String?   @db.Uuid
  displayName         String
  genericName         String?
  tradeName           String?
  strengthText        String?
  dosageForm          String?
  route               String?
  sourceText          String?
  status              String    @default("active")
  recordedByUserId    String?   @db.Uuid
  stoppedByUserId     String?   @db.Uuid
  stoppedAt           DateTime? @db.Timestamptz(3)
  stopReason          String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([medicationProductId])
  @@index([drugMarketVariantId])
  @@index([herbalProductId])
  @@index([genericName])
}

model MedicationSafetyCheck {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String?  @db.Uuid
  prescriptionId  String?  @db.Uuid
  status          String   @default("draft")
  contextSummary  String?
  checkedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  patient Patient?                @relation(fields: [patientId], references: [id], onDelete: SetNull)
  alerts  MedicationSafetyAlert[]

  @@index([patientId, status])
  @@index([prescriptionId])
  @@index([createdAt])
}

model MedicationSafetyAlert {
  id               String    @id @default(uuid()) @db.Uuid
  safetyCheckId    String    @db.Uuid
  severity         String
  alertType        String
  title            String
  message          String
  status           String    @default("open")
  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime? @db.Timestamptz(3)
  overrideReason   String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  safetyCheck MedicationSafetyCheck @relation(fields: [safetyCheckId], references: [id], onDelete: Cascade)

  @@index([safetyCheckId, severity])
  @@index([status])
}

model MedicationDataSource {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  sourceType         String
  websiteUrl         String?
  verificationStatus String   @default("catalog_only")
  notes              String?
  active             Boolean  @default(true)
