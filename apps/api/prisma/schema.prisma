  sourceType       String                 @default("local_rule")
  sourceName       String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  findings CareAssistFinding[]

  @@index([category])
  @@index([appliesTo])
  @@index([severity])
  @@index([isActive])
}

model CareAssistFinding {
  id                   String                  @id @default(uuid()) @db.Uuid
  patientId            String                  @db.Uuid
  encounterId          String?                 @db.Uuid
  historySheetId       String?                 @db.Uuid
  prescriptionId       String?                 @db.Uuid
  investigationOrderId String?                 @db.Uuid
  ruleId               String                  @db.Uuid
  title                String
  message              String
  category             CareAssistRuleCategory
  severity             CareAssistSeverity
  status               CareAssistFindingStatus @default(ACTIVE)
  dataUsedJson         Json
  missingFieldsJson    Json
  suggestedActionJson  Json
  sourceJson           Json?
  dueAt                DateTime?               @db.Timestamptz(3)
  snoozedUntil         DateTime?               @db.Timestamptz(3)
  decisionReason       String?
  decidedByUserId      String?                 @db.Uuid
  decidedAt            DateTime?               @db.Timestamptz(3)
  contextHash          String?
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)

  patient            Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter          Encounter?           @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  historySheet       PatientHistorySheet? @relation(fields: [historySheetId], references: [id], onDelete: SetNull)
  prescription       Prescription?        @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  investigationOrder InvestigationOrder?  @relation(fields: [investigationOrderId], references: [id], onDelete: SetNull)
  rule               CareAssistRule       @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  decidedByUser      User?                @relation("CareAssistFindingsDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decisions          CareAssistDecision[]

  @@unique([ruleId, patientId, contextHash])
  @@index([patientId, status])
  @@index([encounterId])
  @@index([historySheetId])
  @@index([prescriptionId])
  @@index([investigationOrderId])
  @@index([category])
  @@index([severity])
  @@index([dueAt])
  @@index([snoozedUntil])
}

