enum CareAssistRuleCategory {
  DOCUMENTATION_COMPLETENESS
  CLINICAL_SAFETY_REVIEW
  FOLLOW_UP
  MEDICATION_SAFETY
  PREGNANCY_SAFETY
  LACTATION_SAFETY
  INVESTIGATION_FOLLOW_UP
  HISTORY_COMPLETENESS
}

enum CareAssistAppliesTo {
  PATIENT
  HISTORY_SHEET
  PRESCRIPTION
  INVESTIGATION_ORDER
  ENCOUNTER
  PREGNANCY
}

enum CareAssistSeverity {
  INFO
  LOW
  MODERATE
  HIGH
  CRITICAL_REVIEW
}

enum CareAssistFindingStatus {
  ACTIVE
  ACCEPTED
  DISMISSED
  SNOOZED
  RESOLVED
}

enum CareAssistDecisionValue {
  ACCEPT
  DISMISS
  SNOOZE
  RESOLVE
}

enum LegacyPregnancyCategory {
  A
  B
  C
  D
  X
  N
  UNKNOWN
  REVIEW_REQUIRED
}

enum LactationRiskLevel {
  COMPATIBLE
  CAUTION
  AVOID
  INSUFFICIENT_DATA
  UNKNOWN
  REVIEW_REQUIRED
}

enum MedicationSafetyProfileSourceType {
  official_label
  curated_reference
  guideline
  licensed_database
  manual_review
  not_reviewed
}

enum MedicationSafetyProfileReviewStatus {
  reviewed
  needs_review
  imported
  rejected
  retired
}

enum MedicationSafetyProfileConfidenceLevel {
  high
  moderate
  low
  unknown
}

model CareAssistRule {
  id               String                 @id @default(uuid()) @db.Uuid
