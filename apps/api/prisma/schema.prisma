generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  code           String     @unique
  addressSummary String?
  phone          String?
  status         String     @default("active")
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  users          User[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  patients       Patient[]
  appointments   Appointment[]
  queueTickets   QueueTicket[]
  reports        Report[]
  pregnancies    Pregnancy[]
  obUltrasounds  ObUltrasound[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([status])
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  displayName   String
  status        String
  passwordHash  String?
  branchId      String?    @db.Uuid
  lastLoginAt   DateTime?  @db.Timestamptz(3)
  failedLoginCount Int     @default(0)
  lockedUntil   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles     UserRole[] @relation("UserRolesUser")
  assignedRoles UserRole[] @relation("UserRolesCreatedBy")
  roleGrants    RolePermission[] @relation("RolePermissionsCreatedBy")
  auditLogs     AuditLog[] @relation("AuditLogsActor")
  createdPatients Patient[] @relation("PatientsCreatedBy")
  doctorAppointments Appointment[] @relation("AppointmentsDoctor")
  createdAppointments Appointment[] @relation("AppointmentsCreatedBy")
  doctorEncounters Encounter[] @relation("EncountersDoctor")
  signedEncounters Encounter[] @relation("EncountersSignedBy")
  doctorPrescriptions Prescription[] @relation("PrescriptionsDoctor")
  doctorInvestigationOrders InvestigationOrder[] @relation("InvestigationOrdersDoctor")
  uploadedReports Report[] @relation("ReportsUploadedBy")
  reviewedReports Report[] @relation("ReportsReviewedBy")
  createdPregnancies Pregnancy[] @relation("PregnanciesCreatedBy")
  createdObUltrasounds ObUltrasound[] @relation("ObUltrasoundsCreatedBy")
  reviewedObUltrasounds ObUltrasound[] @relation("ObUltrasoundsReviewedBy")
  createdInvoices Invoice[] @relation("InvoicesCreatedBy")
  issuedInvoices Invoice[] @relation("InvoicesIssuedBy")
  voidedInvoices Invoice[] @relation("InvoicesVoidedBy")
  recordedPayments Payment[] @relation("PaymentsRecordedBy")
  reversedPayments Payment[] @relation("PaymentsReversedBy")

  @@index([branchId])
  @@index([status])
}

enum PatientStatus {
  active
  inactive
  archived
}

enum AppointmentStatus {
  booked
  rescheduled
  cancelled
  completed
  no_show
}

enum QueueTicketStatus {
  waiting
  called
  completed
  cancelled
}

enum QueuePriority {
  routine
  priority
}

model Patient {
  id                  String        @id @default(uuid()) @db.Uuid
  branchId            String?       @db.Uuid
  medicalRecordNumber String        @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?     @db.Date
  sex                 String?
  phone               String?
  email               String?
  status              PatientStatus @default(active)
  notes               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  createdByUserId     String?       @db.Uuid

  branch              Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser       User?         @relation("PatientsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointments         Appointment[]
  queueTickets         QueueTicket[]
  encounters           Encounter[]
  prescriptions        Prescription[]
  investigationOrders  InvestigationOrder[]
  reports              Report[]
  pregnancies          Pregnancy[]
  obUltrasounds        ObUltrasound[]
  invoices             Invoice[]
  payments             Payment[]

  @@index([branchId])
  @@index([status])
  @@index([lastName, firstName])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  branchId        String            @db.Uuid
  patientId       String            @db.Uuid
  doctorId        String?           @db.Uuid
  startAt         DateTime          @db.Timestamptz(3)
  endAt           DateTime          @db.Timestamptz(3)
  status          AppointmentStatus @default(booked)
  appointmentType String?
  source          String?
  notes           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdByUserId String?           @db.Uuid

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          User?             @relation("AppointmentsDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation("AppointmentsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueTickets    QueueTicket[]
  encounters       Encounter[]

  @@index([branchId, startAt])
  @@index([patientId, startAt])
  @@index([doctorId, startAt])
  @@index([status])
}

model QueueTicket {
  id             String            @id @default(uuid()) @db.Uuid
  branchId       String            @db.Uuid
  patientId      String            @db.Uuid
  appointmentId  String?           @db.Uuid
  queueNumber    Int
  status         QueueTicketStatus @default(waiting)
  priority       QueuePriority     @default(routine)
  checkedInAt    DateTime          @default(now()) @db.Timestamptz(3)
  calledAt       DateTime?         @db.Timestamptz(3)
  completedAt    DateTime?         @db.Timestamptz(3)
  cancelledAt    DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([branchId, queueNumber, checkedInAt])
  @@index([branchId, checkedInAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
}

enum EncounterStatus {
  draft
  signed
  voided
}

enum PrescriptionStatus {
  draft
  signed
  cancelled
  voided
}

enum InvestigationOrderStatus {
  requested
  scheduled
  sample_collected
  sent_out
  result_pending
  result_received
  reviewed
  cancelled
  voided
}

enum InvestigationPriority {
  routine
  urgent
}

enum InvestigationCategory {
  laboratory
  radiology
  ultrasound
  pathology
  cytology
  procedure
  other
}

model Encounter {
  id              String          @id @default(uuid()) @db.Uuid
  patientId       String          @db.Uuid
  appointmentId   String?         @db.Uuid
  doctorId        String          @db.Uuid
  status          EncounterStatus @default(draft)
  chiefComplaint  String?
  historyText     String?
  examText        String?
  assessmentText  String?
  planText        String?
  signedAt        DateTime?       @db.Timestamptz(3)
  signedByUserId  String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor          User            @relation("EncountersDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  signedByUser    User?           @relation("EncountersSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  prescriptions   Prescription[]
  investigationOrders InvestigationOrder[]
  reports         Report[]
  obUltrasounds   ObUltrasound[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([appointmentId])
  @@index([status])
}

model Prescription {
  id              String             @id @default(uuid()) @db.Uuid
  patientId       String             @db.Uuid
  encounterId     String?            @db.Uuid
  doctorId        String             @db.Uuid
  status          PrescriptionStatus @default(draft)
  notes           String?
  signedAt        DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter       Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  doctor          User               @relation("PrescriptionsDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  items           PrescriptionItem[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([doctorId, createdAt])
  @@index([status])
}

model PrescriptionItem {
  id               String       @id @default(uuid()) @db.Uuid
  prescriptionId   String       @db.Uuid
  medicationName   String
  dose             String?
  route            String?
  frequency        String?
  duration         String?
  instructions     String?

  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model InvestigationOrder {
  id              String                   @id @default(uuid()) @db.Uuid
  patientId       String                   @db.Uuid
  encounterId     String?                  @db.Uuid
  doctorId        String                   @db.Uuid
  status          InvestigationOrderStatus @default(requested)
  priority        InvestigationPriority    @default(routine)
  notes           String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  patient         Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter       Encounter?               @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  doctor          User                     @relation("InvestigationOrdersDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  items           InvestigationOrderItem[]
  reports         Report[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([doctorId, createdAt])
  @@index([status])
}

model InvestigationOrderItem {
  id              String                   @id @default(uuid()) @db.Uuid
  orderId         String                   @db.Uuid
  category        InvestigationCategory
  testName        String
  instructions    String?
  status          InvestigationOrderStatus @default(requested)

  order           InvestigationOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([category])
  @@index([status])
}

enum ReportStatus {
  uploaded
  review_pending
  reviewed
  voided
}

enum ReportCategory {
  laboratory
  radiology
  ultrasound
  pathology
  cytology
  external
  other
}

enum PregnancyStatus {
  active
  completed
  loss
  unknown
}

enum ObUltrasoundStatus {
  draft
  reviewed
  voided
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  refunded
  cancelled
  voided
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  mobile_wallet
  other
}

enum PaymentStatus {
  recorded
  reversed
  voided
}

model Report {
  id                   String              @id @default(uuid()) @db.Uuid
  branchId             String?             @db.Uuid
  patientId            String              @db.Uuid
  encounterId          String?             @db.Uuid
  investigationOrderId String?             @db.Uuid
  category             ReportCategory
  status               ReportStatus        @default(uploaded)
  title                String
  source               String?
  fileReference        String?
  resultSummary        String?
  uploadedByUserId     String?             @db.Uuid
  reviewedByUserId     String?             @db.Uuid
  reviewedAt           DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter            Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  investigationOrder   InvestigationOrder? @relation(fields: [investigationOrderId], references: [id], onDelete: SetNull)
  uploadedByUser       User?               @relation("ReportsUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reviewedByUser       User?               @relation("ReportsReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([investigationOrderId])
  @@index([category])
  @@index([status])
}

model Pregnancy {
  id                   String          @id @default(uuid()) @db.Uuid
  branchId             String?         @db.Uuid
  patientId            String          @db.Uuid
  status               PregnancyStatus @default(active)
  gravida              Int?
  para                 Int?
  lmpDate              DateTime?       @db.Date
  estimatedDueDate     DateTime?       @db.Date
  riskLevel            String?
  notes                String?
  createdByUserId      String?         @db.Uuid
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  branch               Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByUser        User?           @relation("PregnanciesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  obUltrasounds        ObUltrasound[]

  @@index([branchId])
  @@index([patientId, createdAt])
  @@index([status])
}

model ObUltrasound {
  id                    String              @id @default(uuid()) @db.Uuid
  branchId              String?             @db.Uuid
  patientId             String              @db.Uuid
  pregnancyId           String?             @db.Uuid
  encounterId           String?             @db.Uuid
  status                ObUltrasoundStatus  @default(draft)
  performedAt           DateTime            @default(now()) @db.Timestamptz(3)
  gestationalAgeWeeks   Int?
  gestationalAgeDays    Int?
  fetalHeartRateBpm     Int?
  presentation          String?
  placenta              String?
  amnioticFluid         String?
  impressionText        String?
  createdByUserId       String?             @db.Uuid
  reviewedByUserId      String?             @db.Uuid
  reviewedAt            DateTime?           @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  branch                Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  pregnancy             Pregnancy?          @relation(fields: [pregnancyId], references: [id], onDelete: SetNull)
  encounter             Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdByUser         User?               @relation("ObUltrasoundsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedByUser        User?               @relation("ObUltrasoundsReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([patientId, performedAt])
  @@index([pregnancyId])
  @@index([encounterId])
  @@index([status])
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  branchId        String?       @db.Uuid
  patientId       String        @db.Uuid
  status          InvoiceStatus @default(draft)
  invoiceNumber   String        @unique
  issueDate       DateTime?     @db.Date
  dueDate         DateTime?     @db.Date
  subtotalAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount   Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  createdByUserId String?       @db.Uuid
  issuedByUserId  String?       @db.Uuid
  issuedAt        DateTime?     @db.Timestamptz(3)
  voidedByUserId  String?       @db.Uuid
  voidedAt        DateTime?     @db.Timestamptz(3)
  voidReason      String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdByUser   User?         @relation("InvoicesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  issuedByUser    User?         @relation("InvoicesIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  voidedByUser    User?         @relation("InvoicesVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@index([branchId, createdAt])
  @@index([patientId, createdAt])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(12, 2)
  lineAmount  Decimal  @db.Decimal(12, 2)
  notes       String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  branchId         String?       @db.Uuid
  patientId        String        @db.Uuid
  invoiceId        String        @db.Uuid
  status           PaymentStatus @default(recorded)
  method           PaymentMethod
  amount           Decimal       @db.Decimal(12, 2)
  paidAt           DateTime      @default(now()) @db.Timestamptz(3)
  referenceNote    String?
  recordedByUserId String?       @db.Uuid
  reversedByUserId String?       @db.Uuid
  reversedAt       DateTime?     @db.Timestamptz(3)
  reverseReason    String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedByUser   User?         @relation("PaymentsRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  reversedByUser   User?         @relation("PaymentsReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, paidAt])
  @@index([patientId, paidAt])
  @@index([invoiceId])
  @@index([status])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  isSystemRole    Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String?
  riskLevel       String           @default("medium")
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([riskLevel])
}

model UserRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  roleId          String   @db.Uuid
  branchId        String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  user            User     @relation("UserRolesUser", fields: [userId], references: [id], onDelete: Cascade)
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUser   User?    @relation("UserRolesCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([branchId])
  @@index([roleId])
  @@index([createdByUserId])
}

model RolePermission {
  roleId          String   @db.Uuid
  permissionId    String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser   User?      @relation("RolePermissionsCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([createdByUserId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?  @db.Uuid
  metadataJson Json?
  ipAddress    String?  @db.Inet
  userAgent    String?
  branchId     String?  @db.Uuid
  severity     String   @default("low")
  reason       String?
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  actorUser    User?    @relation("AuditLogsActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([branchId, createdAt])
  @@index([action])
  @@index([severity, createdAt])
}
