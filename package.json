{
  "name": "prij-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Prij Clinic MVP monorepo scaffold.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev-ports.ps1",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "start:web": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:test": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "test:rbac": "powershell -ExecutionPolicy Bypass -File scripts/rbac-test.ps1",
    "test:scope": "powershell -ExecutionPolicy Bypass -File scripts/scope-test.ps1",
    "test:audit": "powershell -ExecutionPolicy Bypass -File scripts/audit-test.ps1",
    "test:ai-safety": "powershell -ExecutionPolicy Bypass -File scripts/ai-safety-test.ps1",
    "test:security": "powershell -ExecutionPolicy Bypass -File scripts/security-test-all.ps1",
    "test:security:ci": "node scripts/security-integration-test.mjs",
    "test:routes:auth": "node scripts/route-authorization-test.mjs",
    "test:scope:records": "node scripts/referenced-scope-test.mjs",
    "test:audit:assertions": "node scripts/audit-assertion-test.mjs",
    "test:ai:regression": "node scripts/ai-safety-regression-test.mjs",
    "test:admin:control": "node scripts/admin-control-test.mjs",
    "test:theme:ui": "node scripts/theme-ui-test.mjs",
    "test:theme:matrix": "node scripts/theme-matrix-test.mjs",
    "test:doctor:ux": "node scripts/doctor-friendly-ui-test.mjs",
    "test:data:hygiene": "node scripts/data-hygiene-test.mjs",
    "test:reference:data": "node scripts/reference-data-test.mjs",
    "test:clinical:persistence": "node scripts/clinical-persistence-test.mjs",
    "test:gyn:starter": "node scripts/general-gynecology-starter-test.mjs",
    "test:obgyn:core": "node scripts/obgyn-core-depth-test.mjs",
    "test:visual:qa": "node scripts/visual-qa-sweep.mjs",
    "test:staging:smoke": "node scripts/staging-smoke-test.mjs",
    "test:medications": "node scripts/medication-intelligence-test.mjs",
    "test:drug-market": "node scripts/medication-intelligence-test.mjs",
    "test:drug-market:auto-import": "node scripts/medication-intelligence-test.mjs",
    "test:medication-intelligence": "node scripts/medication-intelligence-test.mjs",
    "test:integrated:probes": "node scripts/integrated-route-page-probes.mjs",
    "guidelines:import-open": "node scripts/guidelines-import-open.mjs",
    "guidelines:reindex": "node scripts/guidelines-reindex.mjs",
    "guidelines:check-updates": "node scripts/guidelines-check-updates.mjs",
    "reference:import:medications": "node scripts/reference-import-medications.mjs",
    "reference:import:herbs": "node scripts/reference-import-herbs.mjs",
    "reference:import:drug-market": "node scripts/reference-import-drug-market.mjs",
    "reference:guidelines:sources": "node scripts/reference-guidelines-sources.mjs",
    "test:guidelines": "node scripts/guidelines-library-test.mjs",
    "test:accounts:rbac": "node scripts/accounts-session-rbac-test.mjs",
    "test:finance:reports": "node scripts/finance-reports-test.mjs",
    "test:security:expanded": "node scripts/security-test-all.mjs",
    "test:protocol-atlas": "node scripts/protocol-atlas-test.mjs",
    "test:ai-management": "node scripts/ai-management-test.mjs",
    "test:e2e:v01": "node scripts/e2e-v01-workflow-test.mjs",
    "staging:env:check": "powershell -ExecutionPolicy Bypass -File scripts/staging-env-check.ps1",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:repair": "powershell -ExecutionPolicy Bypass -File scripts/prisma-repair-client.ps1",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w apps/api",
    "prisma:migrate:local": "powershell -ExecutionPolicy Bypass -File scripts/prisma-migrate-local.ps1",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w apps/api",
    "prisma:seed": "npm run prisma:seed -w apps/api",
    "seed:clean": "powershell -ExecutionPolicy Bypass -Command \"$env:PRIJ_SEED_MODE='clean'; npm run prisma:seed -w apps/api\"",
    "seed:test-fixtures": "powershell -ExecutionPolicy Bypass -Command \"$env:PRIJ_SEED_MODE='test'; npm run prisma:seed -w apps/api\"",
    "seed:reference": "powershell -ExecutionPolicy Bypass -Command \"$env:PRIJ_SEED_MODE='clean'; npm run prisma:seed -w apps/api\"",
    "db:reset:clinic-data": "node scripts/reset-local-clinic-data.mjs",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/backup-local-db.ps1",
    "backup:staging": "powershell -ExecutionPolicy Bypass -File scripts/backup-staging-db.ps1",
    "restore:local": "powershell -ExecutionPolicy Bypass -File scripts/restore-local-db.ps1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0"
  }
}
