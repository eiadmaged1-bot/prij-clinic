# Prij Clinic production environment example
# Placeholder values only. Do not put real secrets in this file.
# Production patient use remains blocked until legal/security/privacy launch gates pass.

APP_ENV=production
NODE_ENV=production
API_PORT=3001
API_URL=https://api.example.invalid
APP_URL=https://app.example.invalid
NEXT_PUBLIC_API_URL=https://api.example.invalid

DATABASE_URL=postgresql://PRODUCTION_USER:PRODUCTION_PASSWORD@PRODUCTION_DB_HOST:5432/PRODUCTION_DB
JWT_SECRET=replace-with-random-production-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled

# Demo credentials and demo data are forbidden in production.
SEED_DEMO_DATA=false
SEED_DEMO_OWNER=false
