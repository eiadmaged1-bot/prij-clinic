# Prij Clinic production environment example.
# Documentation only. V0.1 is not approved for real production or real patient data.
# Real values must come from a secret manager or deployment platform, never from git.

APP_ENV=production
NODE_ENV=production
APP_URL=https://clinic.example.invalid
API_PORT=3001
API_URL=https://api.clinic.example.invalid
CORS_ORIGIN=https://clinic.example.invalid

DATABASE_URL=SECRET_MANAGER_DATABASE_URL
JWT_SECRET=SECRET_MANAGER_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=1h

# AI is disabled by default and must not be enabled without a separate approved design.
AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled

# Production storage must be encrypted, access-controlled, audited, backed up, and malware-scanned.
UPLOAD_STORAGE_ROOT=/secure/prij-clinic/uploads
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
BACKUP_ROOT=/secure/prij-clinic/backups

# Logs must not include PHI, clinical note bodies, tokens, passwords, or payment secrets.
LOG_LEVEL=info
LOG_REQUESTS=false
MONITORING_DSN=SECRET_MANAGER_MONITORING_DSN

# Production consent/privacy mode must be defined after legal/privacy review.
CONSENT_PRIVACY_MODE=legal_review_required
