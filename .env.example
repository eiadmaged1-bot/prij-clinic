# Prij Clinic environment example
# Placeholder values only. Do not put real secrets or patient data in this file.

APP_ENV=development
APP_NAME=Prij Clinic
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001

# Database
DATABASE_URL=postgresql://prij_clinic_dev:prij_clinic_dev_password@localhost:5432/prij_clinic_dev

# Authentication/session
SESSION_SECRET=replace-with-local-development-secret
PASSWORD_HASH_PEPPER=replace-with-local-development-placeholder

# File storage for reports/uploads
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage/demo

# Backups
BACKUP_STORAGE_DRIVER=local
BACKUP_STORAGE_PATH=./backups/demo

# Email/SMS providers are intentionally disabled for MVP planning.
EMAIL_PROVIDER=disabled
SMS_PROVIDER=disabled

# AI is disabled for the initial build phase.
AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled
