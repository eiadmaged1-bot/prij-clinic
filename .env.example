# Prij Clinic local development environment example.
# Placeholder values only. Do not commit real secrets, API keys, tokens, PHI, or patient data.

APP_ENV=development
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Local Docker Postgres from docker-compose.yml.
DATABASE_URL=postgresql://prij_clinic_dev:prij_clinic_dev_password@localhost:5432/prij_clinic_dev

# Use a local-only random value in real .env. Do not reuse this placeholder.
JWT_SECRET=replace-with-local-development-secret
JWT_EXPIRES_IN=1h

# AI must remain disabled/mock-only for V0.1.
AI_FEATURES_ENABLED=false
AI_PROVIDER=disabled

# Local/demo seed only. Never use real staff or patient data in seed values.
DEMO_OWNER_EMAIL=owner@prij.local
DEMO_OWNER_PASSWORD=LocalDev123!
DEMO_TEST_PASSWORD=LocalDev123!
SEED_DEMO_OWNER=true

# Local-only storage/backup roots. These folders are ignored by git.
UPLOAD_STORAGE_ROOT=uploads
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
BACKUP_ROOT=backups

# Logging must avoid PHI/secrets.
LOG_LEVEL=info
LOG_REQUESTS=false
MONITORING_DSN=disabled

# V0.1 consent/privacy is a foundation only, not production legal enforcement.
CONSENT_PRIVACY_MODE=demo_foundation
